# API Gateway Settings
ENVIRONMENT=development
PORT=8080

# Downstream Microservices URLs
AUTH_SERVICE_URL=http://localhost:8001
CONVERSATION_SERVICE_URL=http://localhost:8002
LLM_SERVICE_URL=http://localhost:8003
GRAPH_SERVICE_URL=http://localhost:8000
MEMORY_SERVICE_URL=http://localhost:8004

# Security (JWT signature verification)
# Must match the signing secret of Auth Service for local validation
JWT_SECRET_KEY=supersecretjwtkeyforauthservicelocaldvelopment12345
JWT_ALGORITHM=HS256

# File Service + CORS
FILE_SERVICE_URL=http://localhost:8006
# Comma-separated explicit browser origins, e.g. https://app.example.com.
# Empty = localhost dev origins (development) or no cross-origin access (production).
# "*" is rejected when ENVIRONMENT=production.
CORS_ALLOW_ORIGINS=

# Reverse proxies / load balancers in front of the gateway (comma-separated IPs or CIDRs).
# X-Forwarded-For and CF-Connecting-IP are trusted ONLY when the direct peer is in this list.
# PRODUCTION: you MUST set this to your load balancer / TLS terminator CIDR (e.g. 10.0.0.0/8).
# If it is empty behind an LB, every client appears to have the LB's address and per-IP rate limiting
# in downstream services becomes global.
TRUSTED_PROXIES=
